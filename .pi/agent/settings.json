{
  "packages": [
    "npm:pi-mcp-adapter",
    {
      "source": "npm:pi-terminal-theme",
      "themes": [
        "+themes/terminal.json"
      ]
    },
    "npm:pi-web-access",
    "npm:pi-excalidraw",
    "npm:@zigai/pi-mention-skill",
    "npm:pi-webmcp",
    "git:github.com/alexanderop/pi-references@9c7a1864e2ad69f145edf33d11ed4216e3678456",
    "npm:@plannotator/pi-extension"
  ],
  "npmCommand": [
    "bun"
  ],
  "enabledModels": [
    "opencode/grok-4.6",
    "opencode-go/glm-5.3",
    "openai-codex/gpt-5.6-sol"
  ],
  "enableSkillCommands": false,
  "hideThinkingBlock": false,
  "treeFilterMode": "no-tools",
  "theme": "catppuccin-frappe",
  "themes": [
    "~/Developer/dotfiles/.pi/agent/themes"
  ],
  "showHardwareCursor": true,
  "compaction": {
    "enabled": true
  },
  "terminal": {
    "clearOnShrink": false
  }
}
